---
// Home page — portfolio index.

import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  allProjects,
  allErrors,
  distinctCategories,
  distinctTags,
  findRootCollection,
  projectsByCollection,
} from '../lib/projects';

const rootCollection = findRootCollection();
const groups = projectsByCollection();
const featured = allProjects.filter((p) => p.presentation?.featured);
const rest = allProjects.filter((p) => !p.presentation?.featured && p.type !== 'collection');

const categories = distinctCategories();
const tags = distinctTags();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {allProjects.length > 0
        ? `${allProjects.length} project${allProjects.length === 1 ? '' : 's'} — SrLampi1001 portfolio`
        : 'SrLampi1001 portfolio'}
    </title>
    <meta name="description" content={rootCollection?.description ?? 'Index of projects by SrLampi1001'} />
  </head>
  <body>
    <SiteHeader current="home" />

    {allErrors.length === 0 ? (
      <div class="summary-banner ok">
        <strong>All discovered projects pass schema validation.</strong>
      </div>
    ) : (
      <div class="errors">
        <strong>{allErrors.length} error{allErrors.length === 1 ? '' : 's'}:</strong>
        <ul style="margin-top: var(--space-2);">
          {allErrors.slice(0, 5).map((e) => (
            <li>
              <code>{e.repo}</code>
              {e.path ? ` / ${e.path}` : ''}
              {' '}[{e.stage}] {Array.isArray(e.detail) ? e.detail.join('; ') : e.detail}
            </li>
          ))}
          {allErrors.length > 5 && <li><em>… and {allErrors.length - 5} more</em></li>}
        </ul>
      </div>
    )}

    <div class="stats">
      <div class="stat"><strong>{allProjects.length}</strong><span>projects</span></div>
      <div class="stat"><strong>{groups.length}</strong><span>collections</span></div>
      <div class="stat"><strong>{categories.length}</strong><span>categories</span></div>
      <div class="stat"><strong>{tags.length}</strong><span>tags</span></div>
      <div class="stat"><strong>{allErrors.length}</strong><span>errors</span></div>
    </div>

    {rootCollection && (
      <section class="hero">
        <h2>
          {rootCollection.presentation?.featured && <span aria-hidden="true">★ </span>}
          {rootCollection.name}
        </h2>
        <p class="desc">{rootCollection.description}</p>
        {rootCollection.categories && rootCollection.categories.length > 0 && (
          <ul class="chips">
            {rootCollection.categories.map((c) => <li>{c}</li>)}
          </ul>
        )}
        <p class="meta" style="margin: var(--space-3) 0 0; font-size: var(--text-sm); color: var(--muted);">
          <a href={`/projects/${rootCollection.id}/`}>View collection →</a>
          {' · '}
          <a href={rootCollection._meta?.html_url} target="_blank" rel="noopener">GitHub ↗</a>
          {' — '}{groups.length} top-level collection{groups.length === 1 ? '' : 's'}
          {' · '}{allProjects.length - groups.length - 1} leaf project{allProjects.length - groups.length - 1 === 1 ? '' : 's'}
        </p>
      </section>
    )}

    {featured.length > 0 && (
      <>
        <h2>★ Featured</h2>
        <div class="grid">
          {featured.filter((p) => p !== rootCollection).map((p) => <ProjectCard project={p} />)}
        </div>
      </>
    )}

    {groups.map((g) => (
      <>
        <h2>
          {g.collection.presentation?.featured && <span aria-hidden="true">★ </span>}
          {g.collection.name}
          <span style="font-size: var(--text-sm); color: var(--muted); font-weight: 400; margin-left: var(--space-2);">
            — {g.collection._meta?.path}
          </span>
        </h2>
        <p class="desc">
          {g.collection.description}
          {' '}
          <a href={`/projects/${g.collection.id}/`}>
            View collection →
          </a>
        </p>
        {g.children.length > 0 ? (
          <div class="grid">
            {g.children.map((p) => <ProjectCard project={p} />)}
          </div>
        ) : (
          <p class="desc" style="font-style: italic;">No projects listed yet in this collection.</p>
        )}
      </>
    ))}

    {rest.length > 0 && (
      <>
        <h2>Standalone projects</h2>
        <div class="grid">
          {rest.map((p) => <ProjectCard project={p} />)}
        </div>
      </>
    )}

    {categories.length > 0 && (
      <>
        <h2>Browse by category</h2>
        <ul class="tag-cloud">
          {categories.slice(0, 30).map((c) => (
            <li><a href={`/categories/${c}/`}>{c}</a></li>
          ))}
          {categories.length > 30 && <li><em>… {categories.length - 30} more on <a href="/categories/">the categories page</a></em></li>}
        </ul>
      </>
    )}

    {tags.length > 0 && (
      <>
        <h2>Browse by tag</h2>
        <ul class="tag-cloud">
          {tags.slice(0, 30).map((t) => (
            <li><a href={`/tags/${t}/`}>{t}</a></li>
          ))}
          {tags.length > 30 && <li><em>… {tags.length - 30} more on <a href="/tags/">the tags page</a></em></li>}
        </ul>
      </>
    )}

  </body>
</html>