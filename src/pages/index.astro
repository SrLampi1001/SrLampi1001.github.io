---
// Step 3 — schema-validated multi-source smoke test.
//
// Fetches project.yml from TWO sources (collection root on main, leaf on
// a project branch), validates both against schema/project.schema.json
// using ajv, and renders a side-by-side comparison plus the property
// breakdown for each.
//
// CI calls `npm run validate` to gate; the page is for humans.

import * as YAML from 'yaml';
import Ajv from 'ajv';
import addFormats from 'ajv-formats';

import schema from '../../schema/project.schema.json';

const SOURCES = [
  {
    label: 'Collection root',
    description: 'The root project.yml on the main branch.',
    url: 'https://raw.githubusercontent.com/SrLampi1001/riwi_projects/main/project.yml',
  },
  {
    label: 'Leaf on project/python/workshop_2',
    description: 'A sub-project on a non-default branch (slashes in the name).',
    url: 'https://raw.githubusercontent.com/SrLampi1001/riwi_projects/project/python/workshop_2/project.yml',
  },
];

const ajv = new Ajv({ allErrors: true, strict: false });
addFormats(ajv);
const validate = ajv.compile(schema);

interface SourceResult {
  label: string;
  description: string;
  url: string;
  httpStatus: number | null;
  bytes: number | null;
  fetchedAt: string | null;
  project: any | null;
  valid: boolean;
  errors: string[];
  fetchError: string | null;
  rawYaml: string | null;
}

async function fetchAndValidate(src: typeof SOURCES[number]): Promise<SourceResult> {
  const fetchedAt = new Date().toISOString();
  try {
    const res = await fetch(src.url);
    if (!res.ok) {
      return {
        label: src.label,
        description: src.description,
        url: src.url,
        httpStatus: res.status,
        bytes: null,
        fetchedAt,
        project: null,
        valid: false,
        errors: [`HTTP ${res.status} ${res.statusText}`],
        fetchError: `HTTP ${res.status} ${res.statusText}`,
        rawYaml: null,
      };
    }
    const text = await res.text();
    let doc: any;
    try {
      doc = YAML.parse(text);
    } catch (e) {
      return {
        label: src.label,
        description: src.description,
        url: src.url,
        httpStatus: res.status,
        bytes: text.length,
        fetchedAt,
        project: null,
        valid: false,
        errors: [`YAML parse error: ${e instanceof Error ? e.message : String(e)}`],
        fetchError: null,
        rawYaml: text,
      };
    }

    const projectObj = doc && typeof doc === 'object' && 'project' in doc ? doc.project : doc;
    const ok = validate(projectObj);
    const errors = (validate.errors ?? []).map((e) => {
      const where = e.instancePath || '(root)';
      const extra = e.params ? ` ${JSON.stringify(e.params)}` : '';
      return `${where} ${e.message ?? 'invalid'}${extra}`;
    });
    return {
      label: src.label,
      description: src.description,
      url: src.url,
      httpStatus: res.status,
      bytes: text.length,
      fetchedAt,
      project: projectObj,
      valid: ok,
      errors,
      fetchError: null,
      rawYaml: text,
    };
  } catch (e) {
    return {
      label: src.label,
      description: src.description,
      url: src.url,
      httpStatus: null,
      bytes: null,
      fetchedAt,
      project: null,
      valid: false,
      errors: [e instanceof Error ? e.message : String(e)],
      fetchError: e instanceof Error ? e.message : String(e),
      rawYaml: null,
    };
  }
}

const results = await Promise.all(SOURCES.map(fetchAndValidate));

// Surface any source whose validation failed loudly in the page metadata.
const allValid = results.every((r) => r.valid);
const anyFetched = results.some((r) => r.project !== null);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {allValid ? '✅ ' : '❌ '}project.yml smoke test — Step 3
    </title>
    <style>
      :root {
        --fg: #1a1a1a;
        --muted: #666;
        --bg: #fafafa;
        --border: #e5e5e5;
        --accent: #2563eb;
        --ok-bg: #ecfdf5; --ok-fg: #065f46; --ok-bd: #a7f3d0;
        --err-bg: #fef2f2; --err-fg: #991b1b; --err-bd: #fecaca;
      }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
        color: var(--fg); background: var(--bg);
        max-width: 900px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5;
      }
      h1 { margin-bottom: 0.25rem; }
      h2 { font-size: 1.1rem; margin: 2rem 0 0.5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
      .desc { color: var(--muted); margin-top: 0; }
      dl { display: grid; grid-template-columns: 8rem 1fr; gap: 0.5rem 1rem; margin: 0.5rem 0; }
      dt { color: var(--muted); }
      dd { margin: 0; font-family: ui-monospace, monospace; font-size: 0.95em; word-break: break-word; }
      .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; list-style: none; margin: 0.5rem 0; }
      .chips li { background: #eef2ff; color: #3730a3; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.85em; }
      table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
      th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.04em; }
      td.url { font-family: ui-monospace, monospace; font-size: 0.85em; word-break: break-all; }
      td.valid { font-weight: 600; }
      td.valid.ok  { color: var(--ok-fg); }
      td.valid.err { color: var(--err-fg); }
      td.errors { font-family: ui-monospace, monospace; font-size: 0.8em; color: var(--err-fg); white-space: pre-wrap; }
      .summary { padding: 1rem; border-radius: 6px; margin: 1rem 0; border: 1px solid; }
      .summary.ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok-bd); }
      .summary.err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err-bd); }
      pre { background: #f3f4f6; padding: 0.75rem; border-radius: 6px; overflow: auto; font-size: 0.8em; }
      details { margin: 0.5rem 0; }
      summary { cursor: pointer; color: var(--muted); }
    </style>
  </head>
  <body>

    <h1>project.yml smoke test — Step 3</h1>
    <p class="desc">
      Schema-validated fetch + render. Two sources (one default branch, one
      non-default branch) are validated against
      <code>schema/project.schema.json</code>. The build will eventually
      fail CI on validation errors; for now the page shows the result
      inline so a human can read it.
    </p>

    <div class={`summary ${allValid ? 'ok' : 'err'}`}>
      <strong>{allValid ? 'All sources valid' : 'Validation failed'}</strong> —
      {results.filter((r) => r.valid).length}/{results.length} passed.
    </div>

    <h2>Validation results</h2>
    <table>
      <thead>
        <tr>
          <th>Source</th>
          <th>HTTP</th>
          <th>Bytes</th>
          <th>Valid?</th>
          <th>Errors</th>
        </tr>
      </thead>
      <tbody>
        {results.map((r) => (
          <tr>
            <td>
              <strong>{r.label}</strong><br />
              <span class="desc">{r.description}</span><br />
              <span class="url">{r.url}</span>
            </td>
            <td>{r.httpStatus ?? '—'}</td>
            <td>{r.bytes ?? '—'}</td>
            <td class={`valid ${r.valid ? 'ok' : 'err'}`}>{r.valid ? '✅' : '❌'}</td>
            <td class="errors">{r.errors.length === 0 ? '—' : r.errors.join('\n')}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {results.map((r) => (
      <section>
        <h2>{r.label} {r.valid ? '✅' : '❌'}</h2>
        {!r.project ? (
          <p class="desc">No project data (fetch or parse failed).</p>
        ) : (
          <>
            <p><strong>{r.project.name}</strong> — {r.project.description}</p>

            <h3 style="font-size:0.95rem;margin:0.75rem 0 0.25rem;">Identity</h3>
            <dl>
              <dt>id</dt><dd>{r.project.id}</dd>
              <dt>type</dt><dd>{r.project.type}</dd>
              <dt>status</dt><dd>{r.project.status ?? <em>(not set — defaults to "maintained")</em>}</dd>
            </dl>

            {r.project.categories?.length > 0 && (
              <>
                <h3 style="font-size:0.95rem;margin:0.75rem 0 0.25rem;">Categories</h3>
                <ul class="chips">{r.project.categories.map((c: string) => <li>{c}</li>)}</ul>
              </>
            )}

            {r.project.tags?.length > 0 && (
              <>
                <h3 style="font-size:0.95rem;margin:0.75rem 0 0.25rem;">Tags</h3>
                <ul class="chips">{r.project.tags.map((t: string) => <li>{t}</li>)}</ul>
              </>
            )}

            <h3 style="font-size:0.95rem;margin:0.75rem 0 0.25rem;">Repository</h3>
            <dl>
              <dt>provider</dt><dd>{r.project.repository?.provider ?? '—'}</dd>
              <dt>owner</dt><dd>{r.project.repository?.owner ?? '—'}</dd>
              <dt>name</dt><dd>{r.project.repository?.name ?? '—'}</dd>
              <dt>branch</dt><dd>{r.project.repository?.branch ?? '—'}</dd>
            </dl>

            {(() => {
              const ts = r.project.tech_stack ?? {};
              const lines: string[] = [];
              for (const k of ['languages', 'frameworks', 'libraries', 'databases', 'infrastructure', 'tools']) {
                if (ts[k]?.length) lines.push(`${k}: ${ts[k].join(', ')}`);
              }
              if (lines.length === 0) return null;
              return (
                <>
                  <h3 style="font-size:0.95rem;margin:0.75rem 0 0.25rem;">Tech stack</h3>
                  <ul>{lines.map((l) => <li>{l}</li>)}</ul>
                </>
              );
            })()}

            {r.project.documentation && (
              <>
                <h3 style="font-size:0.95rem;margin:0.75rem 0 0.25rem;">Documentation</h3>
                <pre>{JSON.stringify(r.project.documentation, null, 2)}</pre>
              </>
            )}

            {r.project.presentation && (
              <>
                <h3 style="font-size:0.95rem;margin:0.75rem 0 0.25rem;">Presentation</h3>
                <pre>{JSON.stringify(r.project.presentation, null, 2)}</pre>
              </>
            )}

            <details>
              <summary>Raw YAML ({r.bytes} bytes)</summary>
              <pre>{r.rawYaml}</pre>
            </details>
          </>
        )}
      </section>
    ))}

    <h2>Contract decisions (Step 3)</h2>
    <ol>
      <li>
        <strong>Branch mismatch (Steps 1→3):</strong> the YAML's
        <code>repository.branch</code> is treated as a hint. When set, the
        portfolio fetches from it; otherwise it falls back to GitHub's
        default branch. The schema requires <code>branch</code> only on
        the deployed-fetch path; the YAML is allowed to be absent in
        projects that always live on the default branch.
      </li>
      <li>
        <strong>Categories casing (Step 1):</strong> categories are
        free-form strings. The schema accepts any non-empty string; the
        docs use "Frontend" in examples but lowercase is equally valid.
      </li>
      <li>
        <strong><code>tools</code> slot (Step 1):</strong> intentionally
        permissive — accepts any meaningful term, e.g. <code>git</code>,
        <code>subtrees</code>, <code>submodules</code>.
      </li>
      <li>
        <strong><code>type</code> enum (Step 2→3):</strong> extended from
        5 to 11 values: <code>script</code>, <code>library</code>,
        <code>experiment</code>, <code>tool</code>, <code>tutorial</code>,
        <code>docs</code> added.
      </li>
      <li>
        <strong><code>documentation.folders</code> (Step 2→3):</strong>
        added as canonical. The existing
        <code>documentation.documentation-folder</code> form is accepted
        as a legacy alias.
      </li>
      <li>
        <strong><code>status</code> (new in Step 3):</strong> removed from
        the required list (real data omits it). Enum extended to include
        <code>completed</code> and <code>wip</code>. Default when absent:
        <code>maintained</code>.
      </li>
    </ol>

    <p class="desc" style="margin-top:2rem;">
      <code>npm run validate</code> runs the same validator against the
      same two sources. CI will use it to gate.
    </p>

  </body>
</html>