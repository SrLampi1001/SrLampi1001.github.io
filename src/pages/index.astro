---
// Step 4 — multi-project discovery smoke test.
//
// Reads src/data/projects.json and src/data/errors.json (produced by
// `npm run discover`) and renders the discovered project portfolio.
// This replaces the hardcoded two-source fetch from Steps 1-3.

import projects from '../data/projects.json';
import errors from '../data/errors.json';

interface ProjectMeta {
  repo: string;
  path: string;
  branch: string;
  url: string;
  html_url: string;
  description: string | null;
  language: string | null;
  pushed_at: string | null;
  stargazers_count: number;
  default_branch: string;
}

interface Project {
  id: string;
  name: string;
  description: string;
  type: string;
  categories?: string[];
  tags?: string[];
  status?: string;
  tech_stack?: {
    languages?: string[];
    frameworks?: string[];
    libraries?: string[];
    databases?: string[];
    infrastructure?: string[];
    tools?: string[];
  };
  repository: {
    provider: string;
    owner: string;
    name: string;
    branch?: string;
  };
  documentation?: any;
  presentation?: {
    featured?: boolean;
    order?: number;
    thumbnail?: string;
  };
  components?: Record<string, boolean>;
  deployment?: any;
  demo?: any;
  created_at?: string;
  _meta?: ProjectMeta;
}

// Cast the imported JSON (TS doesn't know its exact shape yet —
// Step 5 will replace this with `json-schema-to-typescript`).
const allProjects = (projects as Project[]) ?? [];
const allErrors = (errors as any[]) ?? [];

// Sort: featured first, then by presentation.order, then by repo + path.
const sorted = [...allProjects].sort((a, b) => {
  const fa = a.presentation?.featured ? -1000 : 0;
  const fb = b.presentation?.featured ? -1000 : 0;
  if (fa !== fb) return fa - fb;
  const oa = a.presentation?.order ?? 0;
  const ob = b.presentation?.order ?? 0;
  if (oa !== ob) return oa - ob;
  return (a._meta?.repo ?? '').localeCompare(b._meta?.repo ?? '');
});

const featured = sorted.filter((p) => p.presentation?.featured);
const rest = sorted.filter((p) => !p.presentation?.featured);

// All distinct categories across discovered projects.
const allCategories = Array.from(
  new Set(allProjects.flatMap((p) => p.categories ?? []))
).sort();
const allTypes = Array.from(new Set(allProjects.map((p) => p.type))).sort();
const allLanguages = Array.from(
  new Set(allProjects.flatMap((p) => p.tech_stack?.languages ?? []))
).sort();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {allProjects.length > 0
        ? `${allProjects.length} project${allProjects.length === 1 ? '' : 's'} — SrLampi1001 portfolio`
        : 'SrLampi1001 portfolio'}
    </title>
    <style>
      :root {
        --fg: #1a1a1a;
        --muted: #666;
        --bg: #fafafa;
        --border: #e5e5e5;
        --accent: #2563eb;
        --ok-bg: #ecfdf5; --ok-fg: #065f46; --ok-bd: #a7f3d0;
        --err-bg: #fef2f2; --err-fg: #991b1b; --err-bd: #fecaca;
        --card-bg: #ffffff;
      }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
        color: var(--fg); background: var(--bg);
        max-width: 900px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5;
      }
      h1 { margin-bottom: 0.25rem; }
      h2 { font-size: 1.15rem; margin: 2rem 0 0.5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
      h3 { font-size: 0.95rem; margin: 0.75rem 0 0.25rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
      .desc { color: var(--muted); margin-top: 0; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
      .card {
        background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px;
        padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem;
      }
      .card h3 { margin: 0; color: var(--fg); font-size: 1.05rem; text-transform: none; letter-spacing: 0; font-weight: 600; }
      .card p { margin: 0; font-size: 0.92em; color: var(--muted); }
      .card .chips { margin-top: 0.4rem; }
      .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0; list-style: none; margin: 0.25rem 0; }
      .chips li { background: #eef2ff; color: #3730a3; padding: 0.15rem 0.55rem; border-radius: 9999px; font-size: 0.8em; }
      .meta { font-size: 0.8em; color: var(--muted); }
      .meta a { color: var(--accent); text-decoration: none; }
      .meta a:hover { text-decoration: underline; }
      .stats { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1rem 0; padding: 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; }
      .stat strong { display: block; font-size: 1.4rem; font-weight: 600; }
      .stat span { color: var(--muted); font-size: 0.85em; }
      .summary { padding: 0.75rem 1rem; border-radius: 6px; margin: 1rem 0; border: 1px solid; font-size: 0.95em; }
      .summary.ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok-bd); }
      .summary.err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err-bd); }
      .errors { background: var(--err-bg); border: 1px solid var(--err-bd); border-radius: 6px; padding: 1rem; }
      .errors h3 { color: var(--err-fg); margin: 0 0 0.5rem; }
      .errors ul { margin: 0; padding-left: 1.25rem; font-size: 0.88em; }
      .errors code { background: rgba(0,0,0,0.05); padding: 0.1rem 0.3rem; border-radius: 3px; }
    </style>
  </head>
  <body>

    <h1>SrLampi1001 — Project Portfolio</h1>
    <p class="desc">
      {allProjects.length > 0
        ? `${allProjects.length} project${allProjects.length === 1 ? '' : 's'} discovered across the GitHub account.`
        : 'No projects discovered yet.'}
      Step 4 — multi-project discovery.
    </p>

    <div class="stats">
      <div class="stat"><strong>{allProjects.length}</strong><span>projects</span></div>
      <div class="stat"><strong>{featured.length}</strong><span>featured</span></div>
      <div class="stat"><strong>{allCategories.length}</strong><span>categories</span></div>
      <div class="stat"><strong>{allLanguages.length}</strong><span>languages</span></div>
      <div class="stat"><strong>{allErrors.length}</strong><span>errors</span></div>
    </div>

    {allErrors.length > 0 && (
      <div class="errors">
        <h3>{allErrors.length} validation error{allErrors.length === 1 ? '' : 's'}</h3>
        <ul>
          {allErrors.map((e) => (
            <li>
              <code>{e.repo}</code>
              {e.path ? ` / ${e.path}` : ''}
              {' '}[<strong>{e.stage}</strong>]
              {' '}{Array.isArray(e.detail) ? e.detail.join('; ') : e.detail}
            </li>
          ))}
        </ul>
      </div>
    )}

    {featured.length > 0 && (
      <>
        <h2>★ Featured</h2>
        <div class="grid">
          {featured.map((p) => (
            <article class="card">
              <h3>{p.name}</h3>
              <p>{p.description}</p>
              {p.categories && p.categories.length > 0 && (
                <ul class="chips">
                  {p.categories.map((c) => <li>{c}</li>)}
                </ul>
              )}
              <div class="meta">
                <a href={p._meta?.html_url} target="_blank" rel="noopener">
                  {p._meta?.repo}
                </a>
                {p._meta?.language && <> · {p._meta.language}</>}
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    {rest.length > 0 && (
      <>
        <h2>All projects</h2>
        <div class="grid">
          {rest.map((p) => (
            <article class="card">
              <h3>{p.name}</h3>
              <p>{p.description}</p>
              {p.categories && p.categories.length > 0 && (
                <ul class="chips">
                  {p.categories.map((c) => <li>{c}</li>)}
                </ul>
              )}
              <div class="meta">
                <a href={p._meta?.html_url} target="_blank" rel="noopener">
                  {p._meta?.repo}
                </a>
                {p._meta?.language && <> · {p._meta.language}</>}
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    {allProjects.length === 0 && (
      <div class="summary err">
        <strong>No projects found.</strong>
        Run <code>npm run discover</code> to populate this list.
      </div>
    )}

    <h2>Discovery summary</h2>
    <p class="desc">
      Run <code>npm run discover</code> (or <code>npm run build:full</code>
      to also build) to refresh the project list from GitHub. The script:
    </p>
    <ol>
      <li>Lists every public repo for <code>{`{PORTFOLIO_USER:-SrLampi1001}`}</code>.</li>
      <li>Filters by <code>data/projects.json</code> if present (allow-list).</li>
      <li>For each enabled repo, fetches the root <code>project.yml</code> on the default branch.</li>
      <li>Validates every fetched file against <code>schema/project.schema.json</code>.</li>
      <li>Writes <code>src/data/projects.json</code> + <code>src/data/errors.json</code>.</li>
    </ol>

    {allTypes.length > 0 && (
      <>
        <h2>Project types</h2>
        <ul class="chips">{allTypes.map((t) => <li>{t}</li>)}</ul>
      </>
    )}

    {allCategories.length > 0 && (
      <>
        <h2>All categories</h2>
        <ul class="chips">{allCategories.map((c) => <li>{c}</li>)}</ul>
      </>
    )}

  </body>
</html>