---
// Categories index — lists every category and its project count.

import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import { categoryFacets } from '../../lib/projects';

const facets = categoryFacets();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Categories — SrLampi1001 portfolio</title>
  </head>
  <body>
    <SiteHeader current="categories" />

    <a href="/" class="back-link">← Back to home</a>

    <h1>Categories</h1>
    <p class="desc">{facets.length} categor{facets.length === 1 ? 'y' : 'ies'} across {facets.reduce((sum, f) => sum + f.count, 0)} project{Object.values(facets).reduce((sum, f) => sum + f.count, 0) === 1 ? '' : 's'}.</p>

    <ul class="tag-cloud">
      {facets.map((f) => (
        <li>
          <a href={`/categories/${f.name}/`}>{f.name}</a>
          <span class="count">{f.count}</span>
        </li>
      ))}
    </ul>

  </body>
</html>