---
// Interactive Python demo using Pyodide + xterm.js.
//
// Pyodide 0.28 stdin is fully synchronous: the callback must return
// string | Uint8Array | number | null, never a Promise (which raises
// `OSError: I/O error`). We use a sync queue pre-populated from
// project.demo.inputs.
//
// For stdout/stderr we use the `write` handler (raw bytes) instead
// of `batched`, because `batched` strips the trailing newline from
// each line — combined with xterm.js's default `convertEol: false`,
// that means every "line" collapses onto one. The `write` handler
// gives us the raw bytes including `\n`, which we then convert to
// `\r\n` for the terminal.
//
// True interactive stdin (user types in response to mid-script
// `input()` calls) requires running Pyodide in a Web Worker so a
// blocking stdin doesn't freeze the UI. That's a follow-up.

interface Props {
  /** Repository owner (used to build raw.githubusercontent.com URL) */
  owner: string;
  /** Repository name */
  repo: string;
  /** Branch where the script lives */
  branch?: string;
  /** Path to the Python script inside the repo */
  entrypoint: string;
  /** Pre-baked inputs (one string per call to input()). */
  inputs?: string[];
  /** Display label (defaults to the entrypoint) */
  label?: string;
}

const { owner, repo, branch = 'main', entrypoint, inputs = [], label = entrypoint } = Astro.props;
const scriptUrl = `https://raw.githubusercontent.com/${owner}/${repo}/${encodeURIComponent(branch)}/${entrypoint}`;
const pyodideVersion = '0.28.3';
const pyodideCdn = `https://cdn.jsdelivr.net/pyodide/v${pyodideVersion}/full/`;
---

<div
  class="pyodide-demo"
  data-script-url={scriptUrl}
  data-inputs={JSON.stringify(inputs)}
  data-pyodide-cdn={pyodideCdn}
  data-pyodide-version={pyodideVersion}
>
  <div class="demo-header">
    <span class="demo-title">{label}</span>
    <button class="demo-run" type="button">Run</button>
  </div>
  <div class="demo-body" data-terminal></div>
  <div class="demo-footer">
    <span class="demo-status" data-status>Idle</span>
    <span>· Powered by <a href="https://pyodide.org/" target="_blank" rel="noopener">Pyodide {pyodideVersion}</a> · <a href={scriptUrl} target="_blank" rel="noopener">view source</a></span>
  </div>
</div>

<style>
  .pyodide-demo {
    background: #1a1a1a;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin: var(--space-3) 0;
    overflow: hidden;
  }
  .demo-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    background: rgba(255, 255, 255, 0.05);
    color: #f3f4f6;
    font-family: ui-monospace, monospace;
    font-size: var(--text-sm);
  }
  .demo-title { opacity: 0.85; }
  .demo-run {
    background: #22c55e; color: #052e16; border: none;
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm);
    font-weight: 600; cursor: pointer; font-size: var(--text-sm);
  }
  .demo-run:hover { background: #16a34a; }
  .demo-run:disabled { background: #4b5563; cursor: wait; color: #d1d5db; }
  .demo-body {
    height: 540px;
    background: #1a1a1a;
    color: #f3f4f6;
    padding: var(--space-2);
    overflow: auto;
  }
  .demo-body :global(.xterm) { height: 100%; }
  .demo-body :global(.xterm-viewport) { background-color: transparent !important; }
  .demo-footer {
    padding: var(--space-1) var(--space-3);
    background: rgba(255, 255, 255, 0.03);
    color: #d1d5db;
    font-size: var(--text-xs);
    display: flex; gap: var(--space-2); flex-wrap: wrap;
  }
  .demo-footer a { color: #93c5fd; }
  .demo-status { font-style: italic; opacity: 0.85; }
</style>

<script>
  // Client-side runtime.
  //
  // Pyodide's stdin handler is fully synchronous (per Pyodide 0.28 docs):
  // it accepts strings, Uint8Arrays, or numbers. Returning a Promise
  // raises `OSError: I/O error`. We use a sync queue.
  //
  // Pyodide's `batched` stdout handler strips the trailing newline
  // from each line. Combined with xterm.js's default `convertEol: false`,
  // this means output appears as one long line. We use the `write`
  // handler (raw bytes) and convert `\n` to `\r\n` ourselves.

  declare global {
    interface Window {
      Terminal: any;
      FitAddon: any;
      loadPyodide: any;
    }
  }

  const state = {
    pyodidePromise: null as Promise<any> | null,
    xtermLoaded: false,
  };

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(s);
    });
  }

  async function loadXterm(): Promise<{ Terminal: any; FitAddon: any }> {
    if (state.xtermLoaded) return { Terminal: window.Terminal, FitAddon: window.FitAddon };
    await loadScript('https://cdn.jsdelivr.net/npm/@xterm/xterm@5.4.0/lib/xterm.js');
    await loadScript('https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.9.0/lib/addon-fit.js');
    if (!document.querySelector('link[data-xterm]')) {
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = 'https://cdn.jsdelivr.net/npm/@xterm/xterm@5.4.0/css/xterm.css';
      l.dataset.xterm = 'true';
      document.head.appendChild(l);
    }
    state.xtermLoaded = true;
    return { Terminal: window.Terminal, FitAddon: window.FitAddon };
  }

  async function loadPyodide(version: string): Promise<any> {
    if (!state.pyodidePromise) {
      state.pyodidePromise = (async () => {
        await loadScript(`https://cdn.jsdelivr.net/pyodide/v${version}/full/pyodide.js`);
        return await window.loadPyodide({
          indexURL: `https://cdn.jsdelivr.net/pyodide/v${version}/full/`,
        });
      })();
    }
    return state.pyodidePromise;
  }

  /**
   * Convert raw stdout/stderr bytes to terminal-friendly text:
   * - decode UTF-8 to a string
   * - replace `\n` with `\r\n` (terminals need both CR and LF)
   * - return as a string xterm.js can write directly
   */
  function bytesToTerminalString(buf: Uint8Array): string {
    const decoded = new TextDecoder().decode(buf);
    return decoded.replace(/\r?\n/g, '\r\n');
  }

  // Per-element state. We track the active xterm Terminal per
  // container so re-running disposes the old before creating a new
  // one.
  const containerState = new WeakMap<HTMLElement, { term: any; fit: any }>();

  for (const el of Array.from(document.querySelectorAll<HTMLElement>('.pyodide-demo'))) {
    if (el.dataset.bound === 'true') continue;
    el.dataset.bound = 'true';

    const button = el.querySelector<HTMLButtonElement>('.demo-run')!;
    const body = el.querySelector<HTMLElement>('[data-terminal]')!;
    const statusEl = el.querySelector<HTMLElement>('[data-status]')!;
    const scriptUrl = el.dataset.scriptUrl!;
    const inputsAttr = el.dataset.inputs ?? '[]';
    const inputs: string[] = JSON.parse(inputsAttr);
    const pyodideVersion = el.dataset.pyodideVersion ?? '0.28.3';

    const setStatus = (s: string) => { statusEl.textContent = s; };

    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        // Dispose any previous terminal in this container.
        const prev = containerState.get(body);
        if (prev) {
          try { prev.fit.dispose(); } catch {}
          try { prev.term.dispose(); } catch {}
          containerState.delete(body);
        }
        body.replaceChildren();

        setStatus('Loading xterm.js…');
        const { Terminal, FitAddon } = await loadXterm();
        const term = new Terminal({
          cols: 80,
          rows: 24,
          fontFamily: 'ui-monospace, "SF Mono", Menlo, monospace',
          fontSize: 13,
          cursorBlink: true,
          scrollback: 5000,
          // convertEol defaults to false. We do the \n -> \r\n
          // conversion ourselves in the write callback below so
          // line breaks render correctly.
        });
        const fit = new FitAddon.FitAddon();
        term.loadAddon(fit);
        term.open(body);
        fit.fit();
        containerState.set(body, { term, fit });

        term.write('\x1b[36m=== Python demo ===\x1b[0m\r\n');
        term.write(`Script: ${scriptUrl}\r\n`);
        term.write(`Inputs queued: ${inputs.length}\r\n\r\n`);

        setStatus('Loading Pyodide runtime (~6 MB)…');
        const pyodide = await loadPyodide(pyodideVersion);

        // Sync stdin queue. Each call to Python's input() consumes one
        // entry. If the queue empties, input() raises EOFError.
        const stdinQueue: string[] = [...inputs];

        // Use the `write` handler (raw bytes) instead of `batched`.
        // The batched handler strips trailing newlines, which makes
        // every printed line collapse onto the same row in xterm.js
        // (whose default convertEol is false). The write handler
        // returns the raw bytes; we convert \n -> \r\n ourselves.
        pyodide.setStdout({
          write: (buffer: Uint8Array) => {
            term.write(bytesToTerminalString(buffer));
            return buffer.length;
          },
        });
        pyodide.setStderr({
          write: (buffer: Uint8Array) => {
            term.write('\x1b[31m' + bytesToTerminalString(buffer) + '\x1b[0m');
            return buffer.length;
          },
        });
        pyodide.setStdin({
          stdin: () => stdinQueue.shift() ?? null,
          isatty: false,
        });

        setStatus('Fetching script…');
        const res = await fetch(scriptUrl);
        if (!res.ok) throw new Error(`HTTP ${res.status} fetching ${scriptUrl}`);
        const src = await res.text();
        pyodide.FS.writeFile('/home/pyodide/run.py', src);

        setStatus(`Running (${stdinQueue.length} inputs queued)`);
        button.textContent = 'Restart';

        // Diagnostic prints so it's obvious whether the script ran.
        // If the user sees these but not the script's output, then
        // stdout is being captured but the script body didn't run.
        // If they see neither, runPythonAsync itself failed.
        const scriptFileName = scriptUrl.split('/').pop() ?? 'script.py';
        await pyodide.runPythonAsync(`
import sys
sys.argv = ['${scriptFileName.replace(/'/g, "\\'")}']
print('[debug] about to exec run.py', flush=True)
exec(open('/home/pyodide/run.py').read())
print('[debug] run.py returned, stdin queue remaining:', ${stdinQueue.length}, flush=True)
`);

        setStatus('Done.');
        term.write('\r\n\x1b[32m[finished]\x1b[0m\r\n');
      } catch (e) {
        const msg = e instanceof Error ? e.message : String(e);
        setStatus(`Error: ${msg}`);
        try {
          const cs = containerState.get(body);
          if (cs) cs.term.write(`\r\n\x1b[31m${msg}\x1b[0m\r\n`);
        } catch {}
        button.textContent = 'Retry';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>